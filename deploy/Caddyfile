{
	# Railway terminates TLS at its edge; serve plain HTTP inside the container.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Microphone is used by the Interpreter; everything else stays off.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# Hashed build assets never change, so cache them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The service worker, its manifest and the HTML shell must always be fresh,
	# or users keep running an old version of the app.
	@fresh path /sw.js /registerSW.js /workbox-*.js /manifest.webmanifest /index.html /
	header @fresh Cache-Control "no-cache"

	# Single-page app: unknown paths (e.g. /patients/SMV-1001) serve index.html.
	try_files {path} /index.html
	file_server
}
