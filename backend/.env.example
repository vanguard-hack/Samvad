# Copy to backend/.env for local development (git-ignored). Never commit real keys.
SARVAM_API_KEY=
# Optional: defaults to the frontend's VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: browser origins allowed to call the API directly (not needed with the Vite proxy)
CORS_ORIGINS=

# Voice assistant: Claude on Amazon Bedrock (never commit real keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# Samvad agent (/api/samvad-agent/*): Claude above + the Wispr Flow MCP tools.
# Wispr Flow signs in with OAuth, no API key. Tokens are cached in WISPR_TOKEN_FILE
# (relative to backend/, git-ignored; on Railway use a volume path). Defaults shown.
WISPR_MCP_URL=https://api.wisprflow.ai/connect/mcp
WISPR_OAUTH_SCOPE=openid offline_access
WISPR_TOKEN_FILE=.wispr_oauth.json
# Optional secret: the token file's JSON or base64 of it (wispr_agent/make_railway_secret.py).
# Seeds WISPR_TOKEN_FILE while it has no tokens. Never commit it.
WISPR_OAUTH_JSON=
# Where browsers reach this API; Wispr Flow redirects to <this>/api/samvad-agent/oauth/callback
PUBLIC_BASE_URL=http://localhost:8000
WISPR_AUTH_TIMEOUT_S=600
# true opens the sign-in page on the server's own desktop (local dev only)
WISPR_OPEN_BROWSER=false

# Appointments (/api/doctors, /api/appointments, /api/fetch-appointments): Google Calendar,
# signed in as the clinic's Google account so each booking gets a Google Meet link and an
# email invite. Create a "Desktop app" OAuth client, put its id and secret here, then run
# `python scripts/google_oauth_login.py`, which adds GOOGLE_OAUTH_REFRESH_TOKEN.
# All three are secrets: on Railway add them as service variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Which calendar of that account: unset or "primary" for its main calendar, or a calendar id
# from the calendar's settings (e.g. abc123@group.calendar.google.com).
GOOGLE_CALENDAR_ID=
# IANA time zone for appointment dates and times
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
