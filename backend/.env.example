# Copy to backend/.env for local development (git-ignored). Never commit real keys.
SARVAM_API_KEY=
# Optional: defaults to the frontend's VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: browser origins allowed to call the API directly (not needed with the Vite proxy)
CORS_ORIGINS=
